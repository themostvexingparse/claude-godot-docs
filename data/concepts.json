 "_doc": "Concept glossary: words from other engines and everyday gameplay phrasing -> the Godot entries they mean. Each phrase is extra searchable text for every target (lexical: like keywords; hybrid/semantic: an extra embedded passage). Optional note is shown when the query matches a phrase word for word. Keep phrases specific (no lone generic words like 'player'), and never copy benchmark queries (eval/concept_queries.json).",
 "concepts": [
  {"phrases": ["prefab", "spawn a prefab", "instantiate a prefab at runtime", "unity Instantiate", "spawnactor", "instance_create", "spawn an object at runtime from code", "create new objects from a template scene", "make many copies of a saved scene"],
   "targets": ["PackedScene.instantiate", "PackedScene", "doc:tutorials/scripting/nodes_and_scene_instances#instancing-scenes", "Node.add_child"],
   "note": "Godot has no prefabs: a saved scene (PackedScene) plays that role. Spawn with `var obj = scene.instantiate()` then `add_child(obj)`."},
  {"phrases": ["duplicate an existing node", "clone an object that is already in the scene"],
   "targets": ["Node.duplicate"]},
